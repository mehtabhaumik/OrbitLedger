{
  "name": "orbit-ledger-workspace",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.14.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/functions",
    "apps/mobile",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-web-apphosting.mjs",
    "start": "npm run start --workspace @orbit-ledger/mobile",
    "start:web:apphosting": "npm run start --workspace @orbit-ledger/web",
    "start:dev-client": "npm run start:dev-client --workspace @orbit-ledger/mobile",
    "android": "npm run android --workspace @orbit-ledger/mobile",
    "android:local": "npm run android:local --workspace @orbit-ledger/mobile",
    "android:dev-client": "npm run android:dev-client --workspace @orbit-ledger/mobile",
    "ios": "npm run ios --workspace @orbit-ledger/mobile",
    "ios:local": "npm run ios:local --workspace @orbit-ledger/mobile",
    "ios:local:clear": "npm run ios:local:clear --workspace @orbit-ledger/mobile",
    "ios:dev-client": "npm run ios:dev-client --workspace @orbit-ledger/mobile",
    "web": "npm run dev --workspace @orbit-ledger/web",
    "mobile:web": "npm run web --workspace @orbit-ledger/mobile",
    "doctor": "npm run doctor --workspace @orbit-ledger/mobile",
    "brand:assets": "npm run brand:assets --workspace @orbit-ledger/mobile",
    "setup:razorpay-test-keys": "node scripts/setup-razorpay-test-secrets.mjs",
    "smoke:razorpay-checkout": "node scripts/razorpay-checkout-smoke.mjs",
    "smoke:razorpay-checkout:connected": "node scripts/razorpay-checkout-smoke.mjs --expect-connected",
    "smoke:razorpay-capture": "node scripts/razorpay-webhook-capture-smoke.mjs",
    "smoke:razorpay-live-collections-webhook": "node scripts/razorpay-live-collections-webhook-smoke.mjs",
    "smoke:razorpay-controlled-sandbox": "node scripts/razorpay-controlled-sandbox-run.mjs",
    "proof:razorpay-sandbox-payment": "node scripts/razorpay-sandbox-payment-proof.mjs",
    "live-collections:razorpay-sandbox-payment": "node scripts/razorpay-sandbox-payment-run.mjs",
    "live-collections:phase-gate": "node scripts/live-collections-phase-gate.mjs",
    "audit:razorpay-secret-mode": "node scripts/razorpay-secret-mode-audit.mjs",
    "prepare:web-production-env": "node scripts/prepare-web-production-env.mjs",
    "verify:web-production-env": "node scripts/verify-web-production-env.mjs",
    "build:web:production": "npm run build",
    "deploy:web:apphosting": "npx -y firebase-tools@15.18.0 deploy --only apphosting:orbit-ledger-web --project orbit-ledger-f41c2",
    "deploy:production": "npx -y firebase-tools@15.18.0 deploy --only functions,apphosting:orbit-ledger-web --project orbit-ledger-f41c2",
    "smoke:live-app-check": "node scripts/smoke-live-app-check.mjs",
    "verify:app-check-readiness": "node scripts/verify-app-check-readiness.mjs",
    "qa:browser-responsive": "node scripts/browser-responsive-qa.mjs",
    "qa:landing-ledger-freeze": "node scripts/landing-ledger-freeze-qa.mjs",
    "qa:seed-web-workspace": "node scripts/seed-web-qa-workspace.mjs",
    "qa:web-browser-smoke": "node scripts/web-browser-smoke.mjs",
    "qa:web-browser-smoke:seeded": "node scripts/web-browser-smoke.mjs --authenticated",
    "qa:web-browser-smoke:seeded:refresh": "npm run qa:seed-web-workspace && node scripts/web-browser-smoke.mjs --authenticated",
    "qa:print-sample-pack": "npx -y tsx scripts/generate-print-sample-pack.ts",
    "typecheck": "npm run typecheck --workspace @orbit-ledger/contracts && npm run typecheck --workspace @orbit-ledger/core && npm run typecheck --workspace @orbit-ledger/ui && npm run typecheck --workspace @orbit-ledger/sync && npm run typecheck --workspace @orbit-ledger/mobile && npm run typecheck --workspace @orbit-ledger/web && npm run typecheck --workspace @orbit-ledger/functions",
    "test": "vitest run apps packages",
    "test:rules": "vitest run firebase/*.rules.test.ts firebase/rules.test.ts --fileParallelism=false --testTimeout=30000 --hookTimeout=30000",
    "test:rules:emulators": "npx -y firebase-tools@13.35.1 emulators:exec --project orbit-ledger-ci --only firestore,storage \"npm run test:rules\"",
    "audit:ci": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.60.0",
    "expo": "~54.0.34",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "fast-uri": "^3.1.2",
    "fast-xml-builder": "^1.2.0",
    "shell-quote": "^1.8.4"
  }
}
