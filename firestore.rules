rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function workspaceRef(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId);
    }

    function ownsWorkspace(workspaceId) {
      return signedIn() &&
        exists(workspaceRef(workspaceId)) &&
        get(workspaceRef(workspaceId)).data.owner_uid == request.auth.uid;
    }

    function ownsWorkspaceDocument() {
      return signedIn() &&
        resource != null &&
        resource.data.owner_uid is string &&
        resource.data.owner_uid == request.auth.uid;
    }

    function officeMemberRef(workspaceId, userId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/office_members/$(userId);
    }

    function userContextSessionRef() {
      return /databases/$(database)/documents/operator_user_context_sessions/$(request.auth.uid);
    }

    function hasActiveUserContextSession(workspaceId, modes) {
      return signedIn() &&
        exists(userContextSessionRef()) &&
        get(userContextSessionRef()).data.status == 'active' &&
        get(userContextSessionRef()).data.target_workspace_id == workspaceId &&
        get(userContextSessionRef()).data.mode in modes &&
        get(userContextSessionRef()).data.expires_at is timestamp &&
        get(userContextSessionRef()).data.expires_at > request.time;
    }

    function sessionTargetIsOwner(workspaceId) {
      return hasActiveUserContextSession(workspaceId, ['act_as_user']) &&
        get(userContextSessionRef()).data.target_is_owner == true;
    }

    function sessionTargetHasRole(workspaceId, roles) {
      return hasActiveUserContextSession(workspaceId, ['act_as_user']) &&
        get(userContextSessionRef()).data.target_office_role in roles;
    }

    function hasActiveOfficeMembership(workspaceId) {
      return signedIn() &&
        exists(officeMemberRef(workspaceId, request.auth.uid)) &&
        get(officeMemberRef(workspaceId, request.auth.uid)).data.status == 'active';
    }

    function hasOfficeRole(workspaceId, roles) {
      return hasActiveOfficeMembership(workspaceId) &&
        get(officeMemberRef(workspaceId, request.auth.uid)).data.role in roles;
    }

    function canReadWorkspace(workspaceId) {
      return ownsWorkspace(workspaceId) ||
        hasActiveOfficeMembership(workspaceId) ||
        hasActiveUserContextSession(workspaceId, ['open_workspace', 'view_as_user', 'act_as_user']);
    }

    function canReadWorkspaceDocument(workspaceId) {
      return ownsWorkspaceDocument() ||
        hasActiveOfficeMembership(workspaceId) ||
        hasActiveUserContextSession(workspaceId, ['open_workspace', 'view_as_user', 'act_as_user']);
    }

    function canManageWorkspaceProfile(workspaceId) {
      return ownsWorkspace(workspaceId) ||
        hasOfficeRole(workspaceId, ['admin']) ||
        sessionTargetIsOwner(workspaceId) ||
        sessionTargetHasRole(workspaceId, ['admin']);
    }

    function canWriteWorkspaceCollection(workspaceId, collectionName) {
      return ownsWorkspace(workspaceId) ||
        (
          collectionName in [
            'customers',
            'customer_timeline_notes',
            'payment_reminders',
            'payment_promises',
            'transactions',
            'products',
            'invoices',
            'invoice_items',
            'invoice_versions',
            'payment_allocations'
          ] &&
          hasOfficeRole(workspaceId, ['admin', 'manager', 'staff'])
        ) ||
        (
          collectionName in [
            'payment_reversals',
            'recurring_invoice_rules',
            'email_queue',
            'payment_provider_events'
          ] &&
          hasOfficeRole(workspaceId, ['admin', 'manager'])
        ) ||
        (
          sessionTargetIsOwner(workspaceId) ||
          (
            collectionName in [
              'customers',
              'customer_timeline_notes',
              'payment_reminders',
              'payment_promises',
              'transactions',
              'products',
              'invoices',
              'invoice_items',
              'invoice_versions',
              'payment_allocations'
            ] &&
            sessionTargetHasRole(workspaceId, ['admin', 'manager', 'staff'])
          ) ||
          (
            collectionName in [
              'payment_reversals',
              'recurring_invoice_rules',
              'email_queue',
              'payment_provider_events'
            ] &&
            sessionTargetHasRole(workspaceId, ['admin', 'manager'])
          )
        );
    }

    function canDeleteWorkspaceCollectionRecord(workspaceId, collectionName) {
      return ownsWorkspace(workspaceId) ||
        (
          collectionName in [
            'customers',
            'customer_timeline_notes',
            'payment_reminders',
            'payment_promises',
            'transactions',
            'products',
            'invoices',
            'invoice_items',
            'invoice_versions',
            'payment_allocations',
            'payment_reversals',
            'recurring_invoice_rules',
            'email_queue'
          ] &&
          hasOfficeRole(workspaceId, ['admin'])
        ) ||
        (
          sessionTargetIsOwner(workspaceId) ||
          (
            collectionName in [
              'customers',
              'customer_timeline_notes',
              'payment_reminders',
              'payment_promises',
              'transactions',
              'products',
              'invoices',
              'invoice_items',
              'invoice_versions',
              'payment_allocations',
              'payment_reversals',
              'recurring_invoice_rules',
              'email_queue'
            ] &&
            sessionTargetHasRole(workspaceId, ['admin'])
          )
        );
    }

    function workspaceProfileAllowedKeys() {
      return [
        'business_name',
        'profile_summary_version',
        'profile_display_name',
        'profile_legal_name',
        'profile_document_name',
        'profile_owner_name',
        'profile_entity_label',
        'profile_entity_subtype_label',
        'profile_verification_status_label',
        'profile_registered_address',
        'profile_business_address',
        'profile_principal_place_of_business',
        'profile_document_address',
        'profile_contact_line',
        'profile_tax_identity_line',
        'profile_registration_identity_line',
        'profile_identity_line',
        'profile_export_name',
        'profile_search_text',
        'profile_search_tokens',
        'profile_has_tax_profile',
        'profile_has_protected_identity',
        'profile_summary_updated_at',
        'legal_name',
        'owner_name',
        'contact_person',
        'business_type',
        'entity_type',
        'entity_subtype',
        'entity_verification_status',
        'entity_compliance_flags',
        'phone',
        'whatsapp',
        'email',
        'website',
        'address',
        'address_line_1',
        'address_line_2',
        'city',
        'town',
        'postal_code',
        'gstin',
        'pan',
        'cin',
        'llpin',
        'tax_number',
        'registration_number',
        'registered_office_address',
        'principal_place_of_business',
        'additional_places_of_business',
        'nonprofit_registration_number',
        'nonprofit_registration_authority',
        'ngo_darpan_id',
        'tax_exemption_12a_12ab_number',
        'tax_deduction_80g_number',
        'fcra_registration_number',
        'csr_registration_number',
        'place_of_supply',
        'default_tax_treatment',
        'default_payment_terms',
        'default_due_days',
        'default_tax_rate',
        'default_invoice_template',
        'default_statement_template',
        'default_invoice_notes',
        'default_recurring_email_subject',
        'default_recurring_email_body',
        'default_recurring_email_include_payment_link',
        'default_recurring_email_attach_pdf',
        'default_recurring_email_current_month_only',
        'default_recurring_email_send_day_behavior',
        'default_recurring_email_day',
        'invoice_number_prefix',
        'invoice_number_separator',
        'invoice_number_padding',
        'invoice_number_next_sequence',
        'invoice_number_last_value',
        'invoice_number_last_sequence',
        'invoice_number_last_issued_at',
        'invoice_number_scheme',
        'document_filename_format',
        'document_footer_preference',
        'document_brand_header_color',
        'document_brand_background_color',
        'document_brand_font_color',
        'reminder_style',
        'overdue_alert_timing',
        'follow_up_cadence_days',
        'payment_notice_tone',
        'urgent_payment_stamp_default',
        'backup_reminder_frequency',
        'whatsapp_reminder_template',
        'email_reminder_template',
        'payment_thank_you_template',
        'bounced_payment_template',
        'default_language',
        'currency',
        'country_code',
        'state_code',
        'logo_uri',
        'document_watermark_type',
        'document_watermark_text',
        'document_watermark_image_uri',
        'document_watermark_opacity',
        'authorized_person_name',
        'authorized_person_title',
        'signature_uri',
        'payment_upi_id',
        'payment_page_url',
        'payment_note',
        'payment_bank_account_name',
        'payment_bank_name',
        'payment_bank_account_number',
        'payment_bank_ifsc',
        'payment_bank_branch',
        'payment_bank_routing_number',
        'payment_bank_sort_code',
        'payment_bank_iban',
        'payment_bank_swift',
        'owner_uid',
        'owner_email',
        'data_state',
        'created_at',
        'updated_at',
        'server_revision'
      ];
    }

    function workspaceOptionalString(key) {
      return request.resource.data.get(key, null) == null ||
        request.resource.data.get(key, null) is string;
    }

    function workspaceOptionalStringList(key, maxSize) {
      return request.resource.data.get(key, null) == null ||
        (
          request.resource.data.get(key, null) is list &&
          request.resource.data.get(key, null).size() <= maxSize
        );
    }

    function workspaceOptionalChoice(key, values) {
      return request.resource.data.get(key, null) == null ||
        request.resource.data.get(key, null) in values;
    }

    function validWorkspaceRequiredFields() {
      return request.resource.data.owner_uid is string &&
        request.resource.data.business_name is string &&
        request.resource.data.currency is string &&
        request.resource.data.country_code is string &&
        request.resource.data.state_code is string;
    }

    function validWorkspaceProfileDocument() {
      return validWorkspaceRequiredFields() &&
        workspaceOptionalString('profile_display_name') &&
        workspaceOptionalStringList('profile_search_tokens', 48) &&
        (
          request.resource.data.get('profile_summary_version', null) == null ||
          request.resource.data.get('profile_summary_version', null) == 1
        ) &&
        workspaceOptionalChoice(
          'entity_type',
          [
            'freelancer_individual',
            'sole_proprietorship',
            'partnership_firm',
            'llp',
            'company',
            'nonprofit_charity'
          ]
        );
    }

    function keepsApprovedWorkspaceIdentityStable() {
      return resource.data.get('entity_verification_status', null) != 'approved' ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'business_name',
          'legal_name',
          'owner_name',
          'entity_type',
          'entity_subtype',
          'entity_verification_status',
          'gstin',
          'pan',
          'cin',
          'llpin',
          'tax_number',
          'registration_number',
          'nonprofit_registration_number',
          'ngo_darpan_id',
          'tax_exemption_12a_12ab_number',
          'tax_deduction_80g_number',
          'fcra_registration_number',
          'csr_registration_number',
          'profile_display_name',
          'profile_legal_name',
          'profile_document_name',
          'profile_owner_name',
          'profile_entity_label',
          'profile_entity_subtype_label',
          'profile_tax_identity_line',
          'profile_registration_identity_line',
          'profile_identity_line',
          'profile_has_tax_profile',
          'profile_has_protected_identity'
        ]);
    }

    function createsOwnWorkspace() {
      return signedIn() &&
        request.resource.data.owner_uid == request.auth.uid &&
        validWorkspaceRequiredFields();
    }

    function keepsWorkspaceOwner(workspaceId) {
      return signedIn() &&
        request.resource.data.owner_uid == resource.data.owner_uid &&
        canManageWorkspaceProfile(workspaceId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(workspaceProfileAllowedKeys()) &&
        validWorkspaceProfileDocument() &&
        keepsApprovedWorkspaceIdentityStable();
    }

    function canAdvanceInvoiceNumberSequence(workspaceId) {
      return signedIn() &&
        request.resource.data.owner_uid == resource.data.owner_uid &&
        canWriteWorkspaceCollection(workspaceId, 'invoices') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'invoice_number_next_sequence',
          'invoice_number_last_value',
          'invoice_number_last_sequence',
          'invoice_number_last_issued_at',
          'invoice_number_scheme'
        ]) &&
        request.resource.data.invoice_number_next_sequence is number &&
        request.resource.data.invoice_number_last_value is string &&
        request.resource.data.invoice_number_last_sequence is number &&
        request.resource.data.invoice_number_last_issued_at is string &&
        request.resource.data.invoice_number_scheme is string;
    }

    function clientManagedWorkspaceCollection(collectionName) {
      return collectionName != 'subscription_checkouts' &&
        collectionName != 'subscription_events' &&
        collectionName != 'subscription_billing_email_requests' &&
        collectionName != 'subscription_renewal_changes' &&
        collectionName != 'subscription_billing_portal_sessions' &&
        collectionName != 'subscription_admin_queue' &&
        collectionName != 'subscription_renewal_audit' &&
        collectionName != 'office_members' &&
        collectionName != 'office_invitations' &&
        collectionName != 'office_ownership_transfers' &&
        collectionName != 'office_access_audit' &&
        collectionName != 'office_access_requests' &&
        collectionName != 'office_access_admin_queue' &&
        collectionName != 'settings_audit' &&
        collectionName != 'entity_profile_revisions' &&
        collectionName != 'document_vault' &&
        collectionName != 'live_payment_events' &&
        collectionName != 'live_payment_event_raw' &&
        collectionName != 'live_payment_audit' &&
        collectionName != 'live_payment_notifications' &&
        collectionName != 'support_cases' &&
        collectionName != 'support_case_email_requests' &&
        collectionName != 'support_diagnostic_consents' &&
        collectionName != 'support_tickets' &&
        collectionName != 'support_messages' &&
        collectionName != 'support_assignments' &&
        collectionName != 'support_events' &&
        collectionName != 'support_queues' &&
        collectionName != 'support_notification_preferences';
    }

    function validSettingsAuditDocument(workspaceId) {
      return request.resource.data.keys().hasOnly([
          'workspace_id',
          'scope',
          'setting_group',
          'action',
          'actor_uid',
          'actor_email',
          'reason',
          'changed_fields',
          'changes',
          'server_revision_before',
          'server_revision_after',
          'created_at'
        ]) &&
        request.resource.data.workspace_id == workspaceId &&
        request.resource.data.scope is string &&
        request.resource.data.setting_group is string &&
        request.resource.data.action == 'updated' &&
        request.resource.data.actor_uid == request.auth.uid &&
        (request.resource.data.actor_email == null || request.resource.data.actor_email is string) &&
        request.resource.data.reason is string &&
        request.resource.data.changed_fields is list &&
        request.resource.data.changes is list &&
        request.resource.data.server_revision_before is number &&
        request.resource.data.server_revision_after is number &&
        (
          request.resource.data.created_at is timestamp ||
          request.resource.data.created_at is string
        );
    }

    function validEntityProfileRevisionDocument(workspaceId) {
      return request.resource.data.keys().hasOnly([
          'workspace_id',
          'action',
          'actor_uid',
          'actor_email',
          'source',
          'approval_status',
          'reason',
          'changed_fields',
          'changes',
          'previous_snapshot',
          'next_snapshot',
          'linked_document_ids',
          'server_revision_before',
          'server_revision_after',
          'created_at'
        ]) &&
        request.resource.data.workspace_id == workspaceId &&
        request.resource.data.action == 'profile_updated' &&
        request.resource.data.actor_uid == request.auth.uid &&
        (request.resource.data.actor_email == null || request.resource.data.actor_email is string) &&
        request.resource.data.source in ['user', 'admin', 'system'] &&
        request.resource.data.approval_status in ['accepted', 'pending_review', 'rejected'] &&
        request.resource.data.reason is string &&
        request.resource.data.changed_fields is list &&
        request.resource.data.changes is list &&
        request.resource.data.previous_snapshot is map &&
        request.resource.data.next_snapshot is map &&
        request.resource.data.linked_document_ids is list &&
        request.resource.data.server_revision_before is number &&
        request.resource.data.server_revision_after is number &&
        request.resource.data.server_revision_after > request.resource.data.server_revision_before &&
        (
          request.resource.data.created_at is timestamp ||
          request.resource.data.created_at is string
        );
    }

    function validDocumentVaultDocument(workspaceId) {
      return request.resource.data.keys().hasOnly([
          'workspace_id',
          'document_name',
          'document_type',
          'document_type_label',
          'document_category',
          'document_category_label',
          'reason_to_upload',
          'self_attested',
          'attestation_text',
          'file_name',
          'content_type',
          'size',
          'storage_path',
          'download_url',
          'uploaded_by_uid',
          'uploaded_by_email',
          'uploaded_at',
          'created_at',
          'updated_at',
          'entity_type',
          'entity_subtype',
          'verification_status',
          'linked_profile_revision_id'
        ]) &&
        request.resource.data.workspace_id == workspaceId &&
        request.resource.data.document_name is string &&
        request.resource.data.document_name.size() > 0 &&
        request.resource.data.document_type is string &&
        request.resource.data.document_type in [
          'pan_card',
          'identity_proof',
          'address_proof',
          'gst_certificate',
          'bank_proof',
          'udyam_certificate',
          'professional_registration',
          'shop_establishment_registration',
          'partnership_deed',
          'partner_list',
          'authorization_letter',
          'llp_incorporation_certificate',
          'llp_agreement',
          'company_incorporation_certificate',
          'company_pan_proof',
          'registered_office_proof',
          'board_resolution',
          'authorized_signatory_proof',
          'trust_deed',
          'society_registration_certificate',
          'section_8_incorporation_certificate',
          'ngo_registration_certificate',
          'nonprofit_pan_proof',
          'twelve_a_12ab_certificate',
          'eighty_g_certificate',
          'fcra_registration',
          'csr_1_registration',
          'darpan_proof',
          'other'
        ] &&
        request.resource.data.document_type_label is string &&
        request.resource.data.document_type_label.size() > 0 &&
        request.resource.data.document_category in [
          'identity',
          'address',
          'registration',
          'authorization',
          'tax',
          'gst',
          'nonprofit_tax',
          'foreign_contribution',
          'csr',
          'bank',
          'professional',
          'other'
        ] &&
        request.resource.data.document_category_label is string &&
        request.resource.data.document_category_label.size() > 0 &&
        request.resource.data.reason_to_upload is string &&
        request.resource.data.reason_to_upload.size() > 0 &&
        request.resource.data.self_attested == true &&
        request.resource.data.attestation_text is string &&
        request.resource.data.attestation_text.size() > 0 &&
        request.resource.data.file_name is string &&
        request.resource.data.file_name.size() > 0 &&
        request.resource.data.content_type in ['application/pdf', 'image/png', 'image/jpeg'] &&
        request.resource.data.size is number &&
        request.resource.data.size > 0 &&
        request.resource.data.size <= 10 * 1024 * 1024 &&
        request.resource.data.storage_path is string &&
        request.resource.data.storage_path.matches('workspaces/' + workspaceId + '/documents/vault/[^/]+/.+') &&
        request.resource.data.download_url is string &&
        request.resource.data.download_url.size() > 0 &&
        request.resource.data.uploaded_by_uid == request.auth.uid &&
        (request.resource.data.uploaded_by_email == null || request.resource.data.uploaded_by_email is string) &&
        request.resource.data.entity_type in [
          'freelancer_individual',
          'sole_proprietorship',
          'partnership_firm',
          'llp',
          'company',
          'nonprofit_charity'
        ] &&
        (request.resource.data.entity_subtype == null || request.resource.data.entity_subtype is string) &&
        request.resource.data.verification_status == 'uploaded' &&
        request.resource.data.linked_profile_revision_id == null &&
        (
          request.resource.data.uploaded_at is timestamp ||
          request.resource.data.uploaded_at is string
        ) &&
        (
          request.resource.data.created_at is timestamp ||
          request.resource.data.created_at is string
        ) &&
        (
          request.resource.data.updated_at is timestamp ||
          request.resource.data.updated_at is string
        );
    }

    function validOfficeRole(role) {
      return role in ['owner', 'admin', 'manager', 'staff', 'accountant', 'viewer'];
    }

    function validAssignableOfficeRole(role) {
      return role in ['admin', 'manager', 'staff', 'accountant', 'viewer'];
    }

    function adminAssignableOfficeRole(role) {
      return role in ['manager', 'staff', 'accountant', 'viewer'];
    }

    function validOfficeMemberStatus(status) {
      return status in ['active', 'invited', 'suspended', 'removed'];
    }

    function validOfficeInvitationStatus(status) {
      return status in ['pending', 'accepted', 'declined', 'expired', 'revoked'];
    }

    function validOfficeMemberDocument(workspaceId, memberId) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'workspace_id',
          'role',
          'status',
          'email',
          'display_name',
          'invited_by',
          'invited_at',
          'accepted_at',
          'suspended_at',
          'removed_at',
          'last_seen_at',
          'created_at',
          'updated_at'
        ]) &&
        request.resource.data.uid == memberId &&
        request.resource.data.workspace_id == workspaceId &&
        validOfficeRole(request.resource.data.role) &&
        validOfficeMemberStatus(request.resource.data.status);
    }

    function keepsOfficeMemberIdentity(workspaceId, memberId) {
      return request.resource.data.uid == resource.data.uid &&
        request.resource.data.workspace_id == resource.data.workspace_id &&
        resource.data.uid == memberId &&
        resource.data.workspace_id == workspaceId;
    }

    function canCreateOfficeMember(workspaceId, memberId) {
      return validOfficeMemberDocument(workspaceId, memberId) &&
        (
          (
            ownsWorkspace(workspaceId) &&
            memberId == request.auth.uid &&
            request.resource.data.role == 'owner' &&
            request.resource.data.status == 'active'
          ) ||
          (
            ownsWorkspace(workspaceId) &&
            validAssignableOfficeRole(request.resource.data.role)
          ) ||
          (
            hasOfficeRole(workspaceId, ['admin']) &&
            adminAssignableOfficeRole(request.resource.data.role)
          )
        );
    }

    function canUpdateOfficeMember(workspaceId, memberId) {
      return validOfficeMemberDocument(workspaceId, memberId) &&
        keepsOfficeMemberIdentity(workspaceId, memberId) &&
        (
          (
            signedIn() &&
            memberId == request.auth.uid &&
            resource.data.status == 'active' &&
            request.resource.data.status == 'active' &&
            request.resource.data.last_seen_at is string &&
            request.resource.data.updated_at is string &&
            request.resource.data.diff(resource.data).affectedKeys().hasAll(['last_seen_at', 'updated_at']) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_seen_at', 'updated_at'])
          )
        );
    }

    function validOfficeInvitationDocument(workspaceId) {
      return request.resource.data.keys().hasOnly([
          'email',
          'role',
          'status',
          'workspace_id',
          'invited_by',
          'invited_by_name',
          'message',
          'expires_at',
          'accepted_by',
          'accepted_at',
          'revoked_by',
          'revoked_at',
          'created_at',
          'updated_at'
        ]) &&
        request.resource.data.workspace_id == workspaceId &&
        request.resource.data.email is string &&
        validOfficeInvitationStatus(request.resource.data.status) &&
        validAssignableOfficeRole(request.resource.data.role);
    }

    function canCreateOfficeInvitation(workspaceId) {
      return validOfficeInvitationDocument(workspaceId) &&
        request.resource.data.invited_by == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        (
          ownsWorkspace(workspaceId) ||
          (
            hasOfficeRole(workspaceId, ['admin']) &&
            adminAssignableOfficeRole(request.resource.data.role)
          )
        );
    }

    function canUpdateOfficeInvitation(workspaceId) {
      return validOfficeInvitationDocument(workspaceId) &&
        request.resource.data.workspace_id == resource.data.workspace_id &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.invited_by == resource.data.invited_by &&
        (
          ownsWorkspace(workspaceId) ||
          (
            hasOfficeRole(workspaceId, ['admin']) &&
            adminAssignableOfficeRole(resource.data.role) &&
            adminAssignableOfficeRole(request.resource.data.role)
          )
        );
    }

    match /{path=**}/office_members/{memberId} {
      allow get, list: if signedIn() &&
        resource.data.uid == request.auth.uid &&
        resource.data.status == 'active';
    }

    match /platform_users/{userId} {
      allow read, create, update, delete: if false;
    }

    match /platform_user_warnings/{warningId} {
      allow read, create, update, delete: if false;
    }

    match /platform_user_notes/{noteId} {
      allow read, create, update, delete: if false;
    }

    match /platform_admins/{adminId} {
      allow read, create, update, delete: if false;
    }

    match /platform_admin_audit/{auditId} {
      allow read, create, update, delete: if false;
    }

    match /platform_offers/{offerId} {
      allow read, create, update, delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow create: if createsOwnWorkspace();
      allow read: if signedIn() && canReadWorkspaceDocument(workspaceId);
      allow update: if keepsWorkspaceOwner(workspaceId) || canAdvanceInvoiceNumberSequence(workspaceId);
      allow delete: if signedIn() && resource.data.owner_uid == request.auth.uid;

      match /{collectionName}/{recordId} {
        allow read: if canReadWorkspace(workspaceId) &&
          clientManagedWorkspaceCollection(collectionName);
        allow create, update: if clientManagedWorkspaceCollection(collectionName) &&
          canWriteWorkspaceCollection(workspaceId, collectionName);
        allow delete: if clientManagedWorkspaceCollection(collectionName) &&
          canDeleteWorkspaceCollectionRecord(workspaceId, collectionName);
      }

      match /office_members/{memberId} {
        allow read: if canReadWorkspace(workspaceId);
        allow create: if canCreateOfficeMember(workspaceId, memberId);
        allow update: if canUpdateOfficeMember(workspaceId, memberId);
        allow delete: if false;
      }

      match /office_invitations/{invitationId} {
        allow read: if ownsWorkspace(workspaceId) || hasOfficeRole(workspaceId, ['admin']);
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }

      match /office_ownership_transfers/{transferId} {
        allow read: if canReadWorkspace(workspaceId);
        allow create, update, delete: if false;
      }

      match /office_access_audit/{auditId} {
        allow read: if ownsWorkspace(workspaceId) || hasOfficeRole(workspaceId, ['admin', 'accountant']);
        allow create, update, delete: if false;
      }

      match /office_access_requests/{requestId} {
        allow read: if ownsWorkspace(workspaceId) || hasOfficeRole(workspaceId, ['admin']);
        allow create, update, delete: if false;
      }

      match /office_access_admin_queue/{queueId} {
        allow read: if ownsWorkspace(workspaceId);
        allow create, update, delete: if false;
      }

      match /settings_audit/{auditId} {
        allow read: if ownsWorkspace(workspaceId) || hasOfficeRole(workspaceId, ['admin', 'accountant']);
        allow create: if validSettingsAuditDocument(workspaceId) &&
          (ownsWorkspace(workspaceId) || hasOfficeRole(workspaceId, ['admin']));
        allow update, delete: if false;
      }

      match /entity_profile_revisions/{revisionId} {
        allow read: if ownsWorkspace(workspaceId) || hasOfficeRole(workspaceId, ['admin', 'accountant']);
        allow create: if validEntityProfileRevisionDocument(workspaceId) &&
          (ownsWorkspace(workspaceId) || hasOfficeRole(workspaceId, ['admin']));
        allow update, delete: if false;
      }

      match /document_vault/{documentId} {
        allow read: if ownsWorkspace(workspaceId) || hasOfficeRole(workspaceId, ['admin', 'accountant']);
        allow create: if validDocumentVaultDocument(workspaceId) &&
          (ownsWorkspace(workspaceId) || hasOfficeRole(workspaceId, ['admin']));
        allow update, delete: if false;
      }

      match /live_payment_events/{eventId} {
        allow read: if canReadWorkspace(workspaceId);
        allow create, update, delete: if false;
      }

      match /live_payment_event_raw/{eventId} {
        allow read, create, update, delete: if false;
      }

      match /live_payment_audit/{auditId} {
        allow read: if ownsWorkspace(workspaceId) || hasOfficeRole(workspaceId, ['admin', 'accountant']);
        allow create, update, delete: if false;
      }

      match /live_payment_notifications/{notificationId} {
        allow read: if canReadWorkspace(workspaceId);
        allow create, update, delete: if false;
      }

      match /support_diagnostic_consents/{consentId} {
        allow read: if ownsWorkspace(workspaceId) || hasOfficeRole(workspaceId, ['admin', 'accountant']);
        allow create, update, delete: if false;
      }

      match /support_cases/{caseId} {
        allow read: if ownsWorkspace(workspaceId) || hasOfficeRole(workspaceId, ['admin', 'accountant']);
        allow create, update, delete: if false;
      }

      match /support_case_email_requests/{requestId} {
        allow read: if ownsWorkspace(workspaceId) || hasOfficeRole(workspaceId, ['admin', 'accountant']);
        allow create, update, delete: if false;
      }

      match /support_tickets/{ticketId} {
        allow read, create, update, delete: if false;
      }

      match /support_messages/{messageId} {
        allow read, create, update, delete: if false;
      }

      match /support_assignments/{assignmentId} {
        allow read, create, update, delete: if false;
      }

      match /support_events/{eventId} {
        allow read, create, update, delete: if false;
      }

      match /support_queues/{queueId} {
        allow read, create, update, delete: if false;
      }

      match /support_notification_preferences/{preferenceId} {
        allow read, create, update, delete: if false;
      }

      match /{document=**}/support_diagnostic_consents/{consentId} {
        allow read, create, update, delete: if false;
      }

      match /subscription_renewal_changes/{changeId} {
        allow read: if ownsWorkspace(workspaceId);
        allow create, update, delete: if false;
      }

      match /subscription_checkouts/{checkoutId} {
        allow read: if ownsWorkspace(workspaceId);
        allow create, update, delete: if false;
      }

      match /subscription_events/{eventId} {
        allow read: if ownsWorkspace(workspaceId);
        allow create, update, delete: if false;
      }

      match /subscription_billing_email_requests/{requestId} {
        allow read: if ownsWorkspace(workspaceId);
        allow create, update, delete: if false;
      }

      match /subscription_billing_portal_sessions/{sessionId} {
        allow read: if ownsWorkspace(workspaceId);
        allow create, update, delete: if false;
      }

      match /subscription_admin_queue/{queueId} {
        allow read: if ownsWorkspace(workspaceId);
        allow create, update, delete: if false;
      }

      match /subscription_renewal_audit/{auditId} {
        allow read: if ownsWorkspace(workspaceId);
        allow create, update, delete: if false;
      }
    }

    match /users/{userId}/subscription_entitlements/{workspaceId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /users/{userId}/subscription_entitlement_audit/{auditId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
